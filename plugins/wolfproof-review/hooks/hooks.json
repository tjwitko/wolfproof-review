{
  "description": "Before Claude opens a pull request with gh pr create, require a /wolfproof-review of the commit it proposes",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(gh pr create*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-hook.mjs\"", "timeout": 30 },
          { "type": "command", "if": "Bash(gh pr new*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-hook.mjs\"", "timeout": 30 }
        ]
      }
    ]
  }
}
